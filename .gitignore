# Build output
target/
!.mvn/wrapper/maven-wrapper.jar

# Secrets: never commit real environment files
.env
.env.*
!.env.example

# IDEs
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS files and logs
.DS_Store
Thumbs.db
*.log
logs/

# Private keys: never commit
*.pem
*.key
keys/

# JVM crash reports (hs_err) and replay files
hs_err_pid*.log
replay_pid*.log
# Editor workspace files
*.code-workspace
