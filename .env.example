# Copy this file to .env (git-ignored) and change the values.
# It is read by docker-compose.yml AND by the Spring Boot dev profile.

# Optional: the application's port, if 8080 is taken on your machine.
# SERVER_PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=ecommerce_app
DB_PASSWORD=change-me-local-only

# Redis (Phase 11): shared rate limits and the read cache. docker-compose starts it on this port.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   set in production; never commit it

# Optional in dev: without it a temporary signing key is generated at every start.
# Generate one with:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
# JWT_PRIVATE_KEY_LOCATION=file:keys/jwt-private.pem

# Optional: make this (registered, verified) account the first administrator at startup.
# APP_RBAC_BOOTSTRAP_ADMIN_EMAIL=me@example.com
